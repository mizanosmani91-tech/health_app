rules_version = '2';
// স্বাস্থ্য ডায়েরি — Firestore security rules.
// Patient health data is NOT in Firestore (it lives on the phone / user's Drive).
// Firestore only holds: roles, pharmacies, public stock status, requests, owner books.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function roleOf(uid) { return get(/databases/$(db)/documents/users/$(uid)).data.role; }
    function ownsPharmacy(pid) {
      return signedIn() && get(/databases/$(db)/documents/pharmacies/$(pid)).data.ownerId == request.auth.uid;
    }

    // Role is chosen once and can never be changed or deleted by the client.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role in ['patient', 'owner'];
      allow update, delete: if false;
    }

    match /pharmacies/{pid} {
      // Patients see verified shops only; owners always see their own.
      allow read: if signedIn() && (resource.data.status == 'verified' || resource.data.ownerId == request.auth.uid);
      // One shop per owner (doc id == owner uid), always starts as 'pending'.
      allow create: if signedIn() && pid == request.auth.uid
                    && roleOf(request.auth.uid) == 'owner'
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.status == 'pending';
      // Owners can edit shop details but never status / ownerId.
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'ownerId', 'createdAt']);
      allow delete: if false;

      // Private books: prices, quantities, batches, income/expense, credit book.
      match /stock/{id}  { allow read, write: if ownsPharmacy(pid); }
      match /ledger/{id} { allow read, write: if ownsPharmacy(pid); }
      match /khata/{id}  { allow read, write: if ownsPharmacy(pid); }
    }

    // What patients may see: one doc per pharmacy with only name + in/low/out.
    // (No prices or quantities. One read per pharmacy per search keeps us in the free quota.)
    match /stockPublic/{pid} {
      allow read: if signedIn() && get(/databases/$(db)/documents/pharmacies/$(pid)).data.status == 'verified';
      allow write: if ownsPharmacy(pid);
    }

    // Owner-only; license photo stored as a small compressed image (Storage needs a paid plan).
    match /licenses/{pid} { allow read, write: if ownsPharmacy(pid); }

    match /requests/{id} {
      allow read: if signedIn() && (resource.data.patientId == request.auth.uid || ownsPharmacy(resource.data.pharmacyId));
      allow create: if signedIn()
                    && request.resource.data.patientId == request.auth.uid
                    && roleOf(request.auth.uid) == 'patient'
                    && request.resource.data.status == 'new'
                    && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 30
                    && get(/databases/$(db)/documents/pharmacies/$(request.resource.data.pharmacyId)).data.status == 'verified';
      // Only the shop answers; identity fields are frozen.
      allow update: if signedIn() && ownsPharmacy(resource.data.pharmacyId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'replyMessage', 'repliedAt', 'items']);
      allow delete: if false;
    }
  }
}
